# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/
.ruff_cache/

# Scryfall cache (large download, auto-refreshed)
.cache/

# Generated deck output
deck_output.txt
deck_output.decklist.txt

# Precon report (generated by --precons)
precon_swaps.txt
precon_swaps.*.decklist.txt

# Personal collection files — never commit these (the history was purged once already)
ManaBox_Collection*.csv
collection_from_logs.csv
collection*.csv
*_collection.csv
arena-export/

# …but the committed test fixtures ARE tracked, and the patterns above would swallow two of them, since
# they are also named collection*.csv. That failure is invisible here and fatal in CI: the suite passes on
# a machine that has the files and fails everywhere else. Negated per-directory, so nothing outside
# tests/fixtures/ is affected — a real collection dropped there would still be ignored only by luck, so
# keep your exports out of that directory.
!tests/fixtures/
!tests/fixtures/*.csv

# Env / secrets / local tool state
.env
.claude/
